{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.digital-lake-ai/lognexus",
  "title": "LogNexus",
  "description": "Universal Git-powered persistent memory, context rules & native MCP server for AI coding agents across Linux, macOS, and Windows.",
  "repository": {
    "url": "https://github.com/digital-lake-ai/lognexus",
    "source": "github"
  },
  "version": "1.3.5",
  "websiteUrl": "https://github.com/digital-lake-ai/lognexus#readme",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@digital-lake/lognexus",
      "version": "1.3.5",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Start the LogNexus JSON-RPC 2.0 stdio MCP server"
        }
      ]
    },
    {
      "registryType": "pypi",
      "identifier": "lognexus-mcp",
      "version": "1.3.5",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "uvx"
    }
  ]
}

    "cursor",
    "cursor-rules",
    "openai",
    "gemini",
    "deepseek",
    "antigravity",
    "orchestrator",
    "code-review",
    "review-gate",
    "traceability",
    "knowledge-graph",
    "context-management",
    "developer-tools",
    "skills",
    "linux",
    "macos",
    "windows",
    "cross-platform"
  ],
  "author": {
    "name": "Digital Lake",
    "url": "https://github.com/digital-lake-ai"
  },
  "contributors": [
    {
      "name": "devallibus",
      "url": "https://github.com/devallibus"
    }
  ],
  "repository": {
    "type": "git",
